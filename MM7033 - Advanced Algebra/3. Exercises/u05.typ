#import "/shared/book.typ": *
#let p = problem.with(code: "MM7033", unit: "U5")
#let items = (
 p(1,"E","U5.1 Tensor relations",[Simplify $(2m)otimes n+m otimes(3n)$ over $ZZ$.],[Move scalars to the tensor.],[Both terms are multiples of $m otimes n$.],[The expression is $2(m otimes n)+3(m otimes n)=5(m otimes n)$ by bilinearity.],[Use tensor relations, not an interpretation as ordered pairs.]),
 p(2,"E","U5.2 Cyclic tensors",[Compute $ZZ/8ZZ otimes_ZZ ZZ/12ZZ$.],[Use the gcd formula.],[The gcd is four.],[The tensor is $ZZ/4ZZ$, since tensoring the second module with $ZZ/8ZZ$ gives its quotient by eight times itself, equivalently $ZZ/(8ZZ+12ZZ)=ZZ/4ZZ$.],[Explain the quotient computation.]),
 p(3,"E","U5.1 Unit tensor",[Give inverse maps proving $R otimes_R M iso M$.],[Multiply the scalar into the module element.],[Use $m|->1 otimes m$ for the inverse.],[The maps are $r otimes m|->r m$ and $m|->1 otimes m$. Their composites are identities because $1m=m$ and $1 otimes r m=r otimes m$ by scalar movement.],[Check well-definedness by bilinearity.]),
 p(4,"E","U5.2 Tensor annihilation",[Compute $QQ otimes_ZZ ZZ/7ZZ$.],[Use the quotient-ring tensor identity.],[Multiplication by seven is onto on $QQ$.],[The tensor is $QQ/7QQ=0$, since any rational $q$ is seven times $q/7$.],[Distinguish this from the Cartesian product of the two groups.]),
 p(5,"C","U5.1 Pure tensors",[Show $e_1 otimes e_1+e_2 otimes e_2$ in $K^2 otimes K^2$ is not a pure tensor.],[Compare its four basis coefficients with those of $u otimes v$.],[A pure tensor gives a matrix of rank at most one.],[Write $u=(a,b),v=(c,d)$. Its coefficient matrix is $mat(a c,a d;b c,b d)$, whose determinant is zero. The displayed tensor has coefficient matrix the identity, determinant one. The coefficients are uniquely determined by the tensor basis, so no pure tensor can equal it.],[Justify the basis-coordinate comparison.]),
 p(6,"C","U5.1 Tensor basis",[Prove $R^m otimes_R R^n$ is free of rank $m n$.],[Expand tensors in the standard bases.],[Coordinate-product bilinear maps detect each coefficient.],[The tensors $e_i otimes f_j$ span by bilinearity. For each pair $(i,j)$, the bilinear map $(u,v)|->u_i v_j$ induces a linear functional taking value one on its matching tensor and zero on the others. These functionals prove independence. Thus the displayed $m n$ tensors form a basis.],[Prove independence over a ring, not only over a field.]),
 p(7,"C","U5.2 Quotient tensors",[Compute $R/I otimes_R R/J$.],[Apply the quotient formula to $M=R/J$.],[The resulting quotient kills both ideals.],[The tensor is $(R/J)/I(R/J)$, canonically isomorphic to $R/(I+J)$. The map sends $[a]otimes[b]$ to $a b+(I+J)$, and its inverse sends $r+(I+J)$ to $[1]otimes[r]$.],[State the canonical maps or justify the quotient identifications.]),
 p(8,"C","U5.2 Failure of injectivity",[Tensor $0 -> ZZ arrow.r^(times 4) ZZ -> ZZ/4ZZ ->0$ with $ZZ/2ZZ$. Describe every resulting map.],[Identify each nonzero tensor using the gcd formula.],[The first induced map is multiplication by four modulo two.],[The nonzero portion is $ZZ/2ZZ arrow.r^0 ZZ/2ZZ arrow.r^id ZZ/2ZZ ->0$. The first map is zero; the quotient map induces the identity on the generator tensors. The sequence remains exact at the last two terms but not injective at the first.],[Explain why a leading zero cannot be retained as an exact term.]),
 p(9,"C","U5.1 Distributivity",[Prove $(M oplus N)otimes P iso (M otimes P)oplus(N otimes P)$.],[Send a pair tensor to its two coordinate tensors.],[Reverse the map using the two inclusions.],[Define $(m,n)otimes p|->(m otimes p,n otimes p)$, which is bilinear and hence descends. In the reverse direction send $m otimes p$ to $(m,0)otimes p$ and $n otimes p$ to $(0,n)otimes p$, then add. Their composites are identities on pure tensors and hence everywhere.],[Verify that the formulas respect the universal properties.]),
 p(10,"A","U5.2 Right exactness",[For a submodule $K<=M$, identify the kernel of $M otimes N -> (M/K)otimes N$.],[The quotient imposes relations $k otimes n=0$.],[Do not assume the map $K otimes N -> M otimes N$ is injective.],[The kernel is the image of $K otimes N$, equivalently the submodule generated by all $k otimes n$ with $k in K$. Quotienting by this submodule classifies bilinear maps on $M times N$ vanishing on $K times N$, exactly the maps descending to $(M/K)times N$. Thus this quotient is the target tensor. The source map from $K otimes N$ may have its own kernel.],[Give the universal-property argument and distinguish image from an embedded copy.]),
 p(11,"A","U5.1 Tensor–Hom correspondence",[Prove $"Hom"_R(M otimes N,P) iso "Hom"_R(M,"Hom"_R(N,P))$ naturally.],[Curry a bilinear map.],[A map $m|->(n|->b(m,n))$ is linear exactly when $b$ is bilinear.],[A linear map from the tensor yields a bilinear $b(m,n)$, which curries to a linear map into the pointwise module of linear maps $N -> P$. Conversely evaluate such a curried map on $n$ to obtain a bilinear map, then use the tensor universal property. Currying and evaluation are inverse, and pre- or postcomposition commutes with both formulas, proving naturality.],[Check linearity in each variable and explain the module structure on Hom.]),
 p(12,"A","U5.2 A torsion tensor vanishes",[Prove $(QQ/ZZ)otimes_ZZ(QQ/ZZ)=0$.],[Every element in the first factor is killed by some positive integer.],[The second factor is divisible by that same integer.],[For a pure tensor $x otimes y$, choose positive $n$ with $n x=0$. Writing $y=q+ZZ$, take $z=q/n+ZZ$ so that $n z=y$. This proves the divisibility used here directly. Then $x otimes y=x otimes n z=n x otimes z=0$. Every tensor is a finite sum of pure tensors, so the whole tensor product vanishes.],[Explain both torsion and divisibility and conclude for sums, not only pure tensors.]),
)
