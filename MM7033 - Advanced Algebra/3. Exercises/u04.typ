#import "/shared/book.typ": *
#let p = problem.with(code: "MM7033", unit: "U4")
#let items = (
 p(1,"E","U4.1 Presentations",[Give a one-generator, one-relation presentation of $ZZ/9ZZ$.],[Use multiplication by nine.],[Its image is exactly the kernel of reduction.],[The presentation is $ZZ arrow.r^(times 9) ZZ -> ZZ/9ZZ ->0$. Reduction is onto and its kernel is $9ZZ$, the image of the first map.],[Verify exactness at the middle and right terms.]),
 p(2,"E","U4.2 Exactness",[Check exactness of $0 -> K arrow.r^i K^2 arrow.r^p K ->0$, where $i(a)=(a,0)$ and $p(a,b)=b$.],[Compute kernel and image.],[Both the kernel of $p$ and image of $i$ are the first coordinate axis.],[$i$ is injective, $p$ is onto, and $ker p=\{(a,0)\}="im"i$. Thus the sequence is short exact. A section is $b|->(0,b)$.],[Check all three requirements.]),
 p(3,"E","U4.1 Finite support",[Give an element of $product_(n>=0)ZZ$ not lying in $bigoplus_(n>=0)ZZ$.],[Use infinitely many nonzero coordinates.],[The all-ones sequence works.],[The tuple $(1,1,1,dots)$ belongs to the product because every coordinate is an integer. Its support is infinite, so it is absent from the direct sum.],[State the support condition.]),
 p(4,"E","U4.1 Free maps",[How is a linear map $R^3 -> M$ determined?],[Choose the images of the three standard basis elements.],[Extend by scalar combinations.],[An arbitrary triple $m_1,m_2,m_3 in M$ gives the unique map $(r_1,r_2,r_3)|->r_1m_1+r_2m_2+r_3m_3$. Conversely every linear map has this form.],[Explain uniqueness by basis expansion.]),
 p(5,"C","U4.2 Nonsplitting",[Prove $0 -> ZZ arrow.r^(times 3) ZZ -> ZZ/3ZZ ->0$ does not split.],[A section's image of $[1]$ must be annihilated by three.],[No nonzero integer is annihilated by three.],[If $s$ were a section, then $3s([1])=s(3[1])=0$, so $s([1])=0$. Reducing this image modulo three gives zero, contradicting that the composite is the identity on $[1]$.],[Use linearity and the section equation.]),
 p(6,"C","U4.2 Free quotients",[Show a short exact sequence with quotient $R^n$ splits.],[Lift each standard basis vector.],[Extend the chosen lifts linearly.],[Choose $b_i$ mapping to the $i$th standard basis vector under the surjection. Define $s(r_1,dots,r_n)=sum_i r_i b_i$. This is linear and composing with the surjection returns the input vector. Thus it is a section and the splitting lemma applies.],[Construct an actual section.]),
 p(7,"C","U4.1 Presentation computation",[Identify the $ZZ$-module generated by $u,v$ with relations $u-2v=0$ and $6v=0$.],[Eliminate $u$ using the first relation.],[The remaining generator has order six.],[Every element becomes a multiple of $v$, and the remaining relation is $6v=0$. The map to $ZZ/6ZZ$ sending $v$ to $[1]$ and $u$ to $[2]$ respects both relations. The reverse map sends $[1]$ to $v$, and their composites are identities. Hence the module is $ZZ/6ZZ$.],[Prove no extra hidden relation remains by constructing inverse maps.]),
 p(8,"C","U4.2 Direct summands",[Prove a direct summand of a projective module is projective.],[Extend a map from the summand using the projection.],[Lift through the larger module and restrict back.],[Write $P=A oplus B$ with $P$ projective. Given $f:A -> N$ and a surjection $M -> N$, compose $f$ with the projection $P -> A$, lift that map to $M$ using projectivity, then restrict along $A -> P$. The resulting map lifts $f$. Thus $A$ is projective.],[State the extension and restriction maps.]),
 p(9,"C","U4.1 Finite rank",[Prove $R^2$ cannot be isomorphic to $R^3$ for a nonzero commutative unital ring.],[Reduce modulo a maximal ideal.],[An isomorphism induces an isomorphism of residue-field vector spaces.],[Choose a maximal ideal $M$. Quotienting the two modules by $M$ times themselves would give an isomorphism $(R/M)^2 iso (R/M)^3$. Vector-space dimension rules this out.],[Explain why the module isomorphism descends to these quotients.]),
 p(10,"A","U4.2 Projective cyclic example",[Show $ZZ/2ZZ$ is not a projective $ZZ$-module.],[Apply its lifting property to reduction $ZZ -> ZZ/2ZZ$.],[Lifting the identity would provide a section.],[If the module were projective, its identity would lift through the surjection from $ZZ$, giving a section. Such a section must send $[1]$ to an integer killed by two, hence to zero, contradicting the section condition. Therefore it is not projective.],[Use the definition of projectivity with fully specified maps.]),
 p(11,"A","U4.2 A projective nonfree module",[Let $R=K times K$ and $e=(1,0)$. Prove $Re$ is projective but is not free.],[Use $R=Re oplus R(1-e)$.],[Every element of $Re$ is annihilated by $(0,1)$.],[The decomposition $R=R e oplus R(1-e)$ follows by splitting $(a,b)=(a,0)+(0,b)$. It makes $R e$ a direct summand of the free module $R$, hence projective. It is nonzero and is annihilated by the nonzero element $(0,1)$. A nonzero free module has a basis vector not annihilated by any nonzero scalar, since its corresponding coordinate is that scalar. Thus $Re$ is not free of any rank.],[Exclude rank zero and justify the annihilator property of free modules.]),
 p(12,"A","U4.2 Splitting from a retraction",[Given a short exact sequence and a retraction $r:B -> A$ of its injection $i$, construct the isomorphism $B iso A oplus C$.],[Subtract $i(r(b))$ to isolate the complementary part.],[The restriction of the quotient map to $ker r$ is an isomorphism.],[The map $p:ker r -> C$ is injective because a kernel element is $i(a)$ with $a=r i(a)=0$. It is onto because any lift $b$ of $c$ can be replaced by $b-i(r(b))$. Let $s$ be its inverse. Then $(a,c)|->i(a)+s(c)$ has inverse $b|->(r(b),p(b))$. Direct substitution verifies both identities.],[Prove the restriction is bijective before using its inverse.]),
)
