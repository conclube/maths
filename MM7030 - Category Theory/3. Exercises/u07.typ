#import "/shared/book.typ": *
#let p = problem.with(code: "MM7030", unit: "U7")
#let items = (
 p(1,"E","U7.1 Adjunction types",[For $F:cal(C) -> cal(D)$ left adjoint to $G$, write the hom-set bijection and the types of the unit and counit components.],[Place $F$ on the source side of the target-category hom set.],[The unit starts at $C$, the counit ends at $D$.],[The bijection is $cal(D)(F C,D) iso cal(C)(C,G D)$. The unit has type $eta_C:C -> G F C$ and the counit $epsilon_D:F G D -> D$.],[Check every object belongs to the category of the displayed hom set.]),
 p(2,"E","U7.1 Currying",[Curry the function $f:ZZ times ZZ -> ZZ$, $f(b,a)=2b-a$.],[Fix the first argument.],[The result is a function assigning a function.],[The transpose sends $b$ to the function $a |-> 2b-a$. Uncurrying evaluates that function at $a$, recovering the original formula.],[State both the curried type and formula.]),
 p(3,"E","U7.2 Evaluation",[Describe the counit of the product–exponential adjunction in sets.],[It evaluates a function at an argument.],[The domain is $X^A times A$.],[The counit is $epsilon_X(f,a)=f(a)$ from $X^A times A$ to $X$. It is the uncurried identity on $X^A$.],[Identify the adjunct correspondence producing it.]),
 p(4,"E","U7.2 Free-vector-space unit",[Describe the unit of the free-vector-space/forgetful adjunction.],[Send a generator to its formal basis vector.],[The source is a set, not a vector space.],[At a set $X$, the unit is $x |-> [x]$ from $X$ to the underlying set of the free vector space $K^(X)$. It is a set function, not a purported linear map on $X$.],[Keep the source category clear.]),
 p(5,"C","U7.1 Power-set adjunction",[Prove direct image along $f:X -> Y$ is left adjoint to inverse image on power-set posets.],[Translate both inequalities into element membership.],[The condition is $f[S] subset.eq T$ iff $S subset.eq f^(-1)[T]$.],[We need $f[S] subset.eq T$ exactly when $S subset.eq f^(-1)[T]$. The left inclusion says every $s in S$ has $f(s) in T$. This is exactly that every $s in S$ belongs to $f^(-1)[T]$, the right inclusion. Both operations are monotone, and the equivalence gives the poset adjunction.],[Check monotonicity and the two-way inclusion equivalence.]),
 p(6,"C","U7.1 Floor and inclusion",[Let $i:ZZ -> RR$ be inclusion as ordered sets. Show $i$ is left adjoint to floor.],[Compare an integer with a real number.],[For integer $n$, $n<=x$ iff $n<=floor(x)$.],[Floor is monotone. Since $floor(x)$ is the greatest integer at most $x$, an integer $n$ satisfies $i(n)<=x$ exactly when $n<=floor(x)$. This is the adjunction criterion for posets.],[Identify which map is left adjoint; ceiling gives the other adjunction.]),
 p(7,"C","U7.2 Free counit",[For a vector space $V$, describe the counit $F U V -> V$ and verify the triangle involving the unit on $U V$.],[A formal linear combination is evaluated as an actual sum.],[A single formal basis vector $[v]$ evaluates to $v$.],[The counit sends $sum_i a_i[v_i]$ to $sum_i a_i v_i$. The unit on the underlying set sends $v$ to $[v]$. Their composite, after applying the forgetful functor as necessary, sends $v$ to $v$, so $U(epsilon_V)eta_(U V)=1_(U V)$.],[Distinguish formal sums from actual vector-space sums.]),
 p(8,"C","U7.2 Transpose formulas",[Given unit and counit, write the transpose of $h:F C -> D$ and the inverse transpose of $k:C -> G D$.],[Use one unit or one counit.],[The formulas are $G h eta_C$ and $epsilon_D F k$.],[The transpose is $G(h)eta_C:C -> G D$. The inverse transpose is $epsilon_D F(k):F C -> D$. Their domains match because the unit lands in $G F C$ and $F(k)$ lands in $F G D$. The triangle identities make the two procedures inverse.],[Check the intermediate objects.]),
 p(9,"C","U7.1 Diagonal adjunctions",[Show the diagonal functor $Delta:cal(C) -> cal(C) times cal(C)$ is left adjoint to the binary-product functor when products exist.],[Maps from $(X,X)$ to $(A,B)$ are pairs of maps.],[The product universal property supplies the corresponding map into $A times B$.],[The hom set in the product category is $cal(C)(X,A) times cal(C)(X,B)$. The product property identifies this naturally with $cal(C)(X,A times B)$. This is exactly $Delta tack.l times$, with the product operation regarded as a functor defined by pairing.],[Mention naturality of the pairing correspondence.]),
 p(10,"A","U7.2 Triangle converse",[Prove the two unit–counit transpose formulas are inverse assuming naturality and the triangle identities.],[Expand each round trip.],[Move the map past the counit or unit using naturality.],[For $h$, the round trip is $epsilon_D F G(h)F eta_C=h epsilon_(F C)F eta_C=h$. For $k$, it is $G epsilon_D G F(k)eta_C=G epsilon_D eta_(G D)k=k$. The middle equalities use counit and unit naturality; the final equalities use the corresponding triangle.],[Name the naturality instance and triangle used in each direction.]),
 p(11,"A","U7.1 Composite adjunctions",[If $F tack.l G$ and $F' tack.l G'$ are composable adjunctions, prove $F'F tack.l GG'$.],[Compose the two hom-set bijections.],[Track the order of the right adjoints.],[For appropriate objects $C,E$, the natural bijections are $cal(E)(F'F C,E) iso cal(D)(F C,G'E) iso cal(C)(C,G G'E)$. Their composite is a bijection natural in both variables, so it is an adjunction. The right adjoints appear in reversed composition order.],[Specify the three categories and ensure the functors compose.]),
 p(12,"A","U7.2 Closure operators",[For an adjunction $F:P -> Q$, $G:Q -> P$ of posets, prove $G F$ is monotone, extensive, and idempotent.],[The unit says $p<=G F p$.],[Use the counit inequality on $F p$ for the reverse idempotence inequality.],[Monotonicity follows by composition. The adjunction applied to $F p<=F p$ gives $p<=G F p$. Applying this to $G F p$ gives $G F p<=G F G F p$. The counit gives $F G(F p)<=F p$; applying monotone $G$ gives $G F G F p<=G F p$. Antisymmetry yields equality, proving idempotence.],[Use both inequalities and antisymmetry.]),
)
